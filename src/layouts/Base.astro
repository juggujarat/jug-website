---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Duke from '../components/Duke.astro';
import { SITE, NAV } from '../lib/site';

interface Crumb { name: string; href: string }
interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 'article' for blog-style pages such as event recaps */
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra schema.org JSON-LD objects for this page */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb trail (Home is added automatically) */
  breadcrumbs?: Crumb[];
  keywords?: string[];
}
const {
  title,
  description = SITE.description,
  image = '/Home/community-banner.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  breadcrumbs,
  keywords = [],
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.fullName} | Java community in Ahmedabad & Gujarat`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const year = new Date().getFullYear();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.fullName,
  alternateName: ['Gujarat JUG', 'JUG Gujarat'],
  url: SITE.url,
  logo: `${SITE.url}/Img/jug-full-logo-svg.svg`,
  description: SITE.description,
  areaServed: 'Gujarat, India',
  sameAs: [SITE.links.linkedin, SITE.links.youtube, SITE.links.luma, SITE.links.linktree],
};
const crumbs = breadcrumbs ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : null;
const crumbLd = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })),
};
const ld = [orgLd, ...(crumbLd ? [crumbLd] : []), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/jug-logo.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="theme-color" content="#e1262d" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="geo.region" content="IN-GJ" />
    <meta name="geo.placename" content="Ahmedabad" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn-primary">Skip to content</a>

    <header id="site-header" class="fixed inset-x-0 top-0 z-40 transition-all duration-300" transition:persist>
      <div class="container-x flex h-18 items-center justify-between gap-4 py-3">
        <Logo />
        <nav aria-label="Main" class="hidden items-center gap-1 rounded-full border border-black/10 bg-white/80 px-2 py-1.5 shadow-sm backdrop-blur-xl lg:flex">
          {NAV.map((n) => (
            <a href={n.href} data-nav={n.href}
              class="rounded-full px-4 py-1.5 text-sm text-ink/75 transition hover:bg-mist hover:text-duke aria-[current=page]:bg-duke aria-[current=page]:text-white">
              {n.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <a href="/get-involved" class="btn-primary hidden sm:inline-flex">Get involved</a>
          <button id="menu-btn" class="grid size-11 place-items-center rounded-full border border-black/15 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden border-t border-black/10 bg-paper/95 backdrop-blur-xl lg:hidden">
        <nav class="container-x flex flex-col py-4" aria-label="Mobile">
          {NAV.map((n) => <a href={n.href} class="border-b border-black/5 py-3 text-2xl font-semibold">{n.label}</a>)}
          <a href="/get-involved" class="btn-primary mt-5 justify-center">Get involved</a>
        </nav>
      </div>
    </header>

    <main id="main">
      {crumbs && (
        <nav aria-label="Breadcrumb" class="container-x pt-24 sm:pt-28">
          <ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <span aria-hidden="true">/</span>}
                {i < crumbs.length - 1 ? <a href={c.href} class="hover:text-duke">{c.name}</a> : <span aria-current="page" class="text-ink">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="relative mt-32 overflow-hidden border-t border-black/10 bg-mist">
      <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div>
          <Logo />
          <p class="mt-5 max-w-sm text-muted">
            A community of Java developers in Gujarat, learning in public since 2024. Free to attend, run by volunteers.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a class="chip hover:text-ink" href={SITE.links.luma} target="_blank" rel="noopener">Luma</a>
            <a class="chip hover:text-ink" href={SITE.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <a class="chip hover:text-ink" href={SITE.links.youtube} target="_blank" rel="noopener">YouTube</a>
            <a class="chip hover:text-ink" href={SITE.links.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            <a class="chip hover:text-ink" href={SITE.links.linktree} target="_blank" rel="noopener">Linktree</a>
          </div>
        </div>
        <div>
          <p class="eyebrow mb-4">Explore</p>
          <ul class="space-y-2 text-ink/80">
            <li><a class="hover:text-duke" href="/events">Events</a></li>
            <li><a class="hover:text-duke" href="/speakers">Speakers</a></li>
            <li><a class="hover:text-duke" href="/gallery">Gallery</a></li>
            <li><a class="hover:text-duke" href={SITE.links.luma} target="_blank" rel="noopener">Upcoming events ↗</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Community</p>
          <ul class="space-y-2 text-ink/80">
            <li><a class="hover:text-duke" href="/about">Our story</a></li>
            <li><a class="hover:text-duke" href="/team">Team & volunteers</a></li>
            <li><a class="hover:text-duke" href="/partners">Partners</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Join in</p>
          <ul class="space-y-2 text-ink/80">
            <li><a class="hover:text-duke" href="/join">Scan &amp; join (QR codes)</a></li>
            <li><a class="hover:text-duke" href={SITE.links.whatsapp} target="_blank" rel="noopener">WhatsApp community ↗</a></li>
            <li><a class="hover:text-duke" href="/speak">Call for speakers</a></li>
            <li><a class="hover:text-duke" href="/volunteer">Volunteer</a></li>
            <li><a class="hover:text-duke" href="/get-involved#sponsor">Sponsor or host</a></li>
          </ul>
        </div>
      </div>
      <div class="container-x flex flex-col items-start justify-between gap-4 border-t border-black/10 py-6 font-mono text-xs text-muted sm:flex-row sm:items-center">
        <p>© {year} Java User Group Gujarat. Java and Duke are trademarks of Oracle and/or its affiliates.</p>
        <p><span class="text-duke">System.out</span>.println(<span class="text-duke-soft">"Made with ☕ in Gujarat"</span>);</p>
      </div>
      <div class="pointer-events-none absolute -bottom-10 right-6 hidden opacity-20 md:block"><Duke size={180} /></div>
    </footer>

    <script>
      function setup() {
        // active nav state
        const path = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
          const href = a.dataset.nav!;
          if (path === href || path.startsWith(href + '/')) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });

        // header background on scroll
        const header = document.getElementById('site-header')!;
        const onScroll = () => ['bg-white/90', 'shadow-sm', 'backdrop-blur-xl'].forEach((c) => header.classList.toggle(c, scrollY > 20));
        onScroll();
        window.onscroll = onScroll;

        // mobile menu
        const btn = document.getElementById('menu-btn')!;
        const menu = document.getElementById('mobile-menu')!;
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.onclick = () => {
          const open = menu.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', String(open));
        };

        // open external links in article text in a new tab
        document.querySelectorAll<HTMLAnchorElement>('.prose-jug a[href^="http"]').forEach((a) => {
          a.target = '_blank';
          a.rel = 'noopener';
        });

        // reveal on scroll
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => io.observe(el));

        // count-up numbers
        const counters = document.querySelectorAll<HTMLElement>('[data-count]');
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            cio.unobserve(el);
            const target = Number(el.dataset.count);
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return void (el.textContent = target.toLocaleString('en-IN'));
            const t0 = performance.now();
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / 1400);
              el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('en-IN');
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        });
        counters.forEach((c) => cio.observe(c));

        // pointer-follow glow on cards
        document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
          el.onpointermove = (ev) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--x', `${ev.clientX - r.left}px`);
            el.style.setProperty('--y', `${ev.clientY - r.top}px`);
          };
        });
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
