---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { getSupportByPartner, ROLE_LABEL } from '../../lib/data';

export async function getStaticPaths() {
  const partners = await getCollection('partners');
  return partners.map((partner) => ({ params: { slug: partner.id }, props: { partner } }));
}
const { partner } = Astro.props;
const d = partner.data;
const { Content } = await render(partner);
const hasBody = Boolean(partner.body?.trim());
const support = (await getSupportByPartner()).get(partner.id) ?? [];
const roles = [...new Set(support.map((s) => ROLE_LABEL[s.role]))];
const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: d.name, url: d.website, logo: d.logo ? new URL(d.logo, Astro.site).href : undefined };
---
<Base title={d.name} description={`${d.name} supports Gujarat JUG${roles.length ? ` as ${roles.join(', ').toLowerCase()}` : ''}.`} image={d.logo} jsonLd={orgLd}
  breadcrumbs={[{ name: 'Partners', href: '/partners' }, { name: d.name, href: `/partners/${partner.id}` }]}>
  <section class="pt-8 pb-12">
    <div class="container-x grid items-center gap-10 md:grid-cols-[280px_1fr]">
      <div class="reveal grid aspect-square place-items-center rounded-[2rem] border border-black/10 bg-white p-10 shadow-lg">
        {d.logo ? <img src={d.logo} alt={d.name} class="max-h-full max-w-full object-contain" /> : <span class="text-center text-3xl font-bold text-ink">{d.name}</span>}
      </div>
      <div>
                <div class="mt-4 flex flex-wrap gap-2">{roles.map((r) => <span class="chip border-duke/40 text-duke">{r}</span>)}</div>
        <h1 class="h-display reveal mt-4 text-5xl sm:text-7xl">{d.name}</h1>
        {d.city && <p class="mt-3 text-muted">{d.city}</p>}
        {d.website && <a href={d.website} target="_blank" rel="noopener" class="btn-ghost mt-6">Visit website ↗</a>}
      </div>
    </div>
  </section>
  <section class="container-x">
    {hasBody ? <div class="prose-jug max-w-3xl"><Content /></div> : null}
    {support.length > 0 && (
      <div class="mt-12">
        <p class="eyebrow">// events they supported</p>
        <div class="mt-6 grid gap-6 md:grid-cols-3">{support.map((s, i) => <EventCard event={s.event} delay={i * 60} />)}</div>
      </div>
    )}
  </section>
</Base>
