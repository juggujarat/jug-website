---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import { getTeam } from '../lib/data';

const { core, volunteers } = await getTeam();
---
<Base title="Team & volunteers" description="The organisers and volunteers who run Gujarat JUG." breadcrumbs={[{ name: "Team", href: "/team" }]}>
  <PageHero eyebrow="// the crew" title="Run by volunteers, fuelled by coffee" lead="Nobody here is paid. Every meetup happens because these people give up their weekends." />

  <section class="container-x">
    <h2 class="text-3xl font-bold">Core team</h2>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
      {core.map((p, i) => <PersonCard person={p} meta={p.data.teamTitle} delay={(i % 4) * 60} />)}
    </div>
  </section>

  <section class="container-x mt-24">
    <h2 class="text-3xl font-bold">Volunteers</h2>
    <p class="mt-2 text-muted">The people behind registrations, stage, photos, design and everything in between.</p>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
      {volunteers.map((p, i) => <PersonCard person={p} delay={(i % 4) * 60} />)}
    </div>
  </section>

  <section class="container-x mt-24">
    <div class="reveal rounded-[2rem] border border-duke/30 bg-duke/5 p-10 text-center">
      <h2 class="text-3xl font-bold">Join the crew</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">Help with check-in, photography, social media, design or stage management. No experience needed.</p>
      <a href="/get-involved#volunteer" class="btn-primary mt-6">Become a volunteer</a>
    </div>
  </section>
</Base>
