---
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Duke from '../../components/Duke.astro';
import EventCard from '../../components/EventCard.astro';
import { formatEventDate, FORMAT_LABEL, ROLE_LABEL, isUpcoming, getEvents } from '../../lib/data';
import { SITE } from '../../lib/site';
import { Image, getImage } from 'astro:assets';
import Lightbox from '../../components/Lightbox.astro';
import { photosFor, bannerFor } from '../../lib/photos';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const upcoming = isUpcoming(event);
const words = (event.body ?? '').split(/\s+/).length;
const readMins = Math.max(2, Math.round(words / 200));

const talks = await Promise.all(d.talks.map(async (t) => ({ ...t, people: await getEntries(t.speakers) })));
const speakers = [...new Map(talks.flatMap((t) => t.people).map((p) => [p.id, p])).values()];
const hosts = await getEntries(d.hosts);
const partners = await Promise.all(d.partners.map(async (p) => ({ role: p.role, entry: (await getEntry(p.partner))! })));
const byRole = (role: string) => partners.filter((p) => p.role === role).map((p) => p.entry);
const venuePartner = byRole('venue')[0];

const all = await getEvents();
const related = all
  .filter((e) => e.id !== event.id)
  .map((e) => ({ e, score: e.data.tags.filter((t) => d.tags.includes(t)).length * 10 - Math.abs(e.data.date.getTime() - d.date.getTime()) / 8.64e9 }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.e);

const ctaUrl = d.registrationUrl ?? d.lumaUrl;
const dateText = formatEventDate(event);
const description =
  d.summary ??
  `${d.title}: a ${FORMAT_LABEL[d.format].toLowerCase()} by Java User Group Gujarat on ${dateText}${d.venueName ? ` at ${d.venueName}` : ''}, ${d.city}${speakers.length ? `, with ${speakers.map((s) => s.data.name).join(', ')}` : ''}.`;

// ---------- structured data ----------
const iso = (time?: string) => {
  const day = d.date.toISOString().slice(0, 10);
  return time && !d.dateApproximate ? `${day}T${time}:00+05:30` : day;
};
const url = new URL(Astro.url.pathname, Astro.site).href;
const banner = bannerFor(event);
// the banner is already shown at the top, so leave it out of the photo grid
const photos = photosFor(event).filter((p) => p !== banner);
const ogImagePath = banner ? (await getImage({ src: banner.image, width: 1200, format: 'jpg' })).src : d.cover;
const image = ogImagePath ? new URL(ogImagePath, Astro.site).href : undefined;
const fullSizes = await Promise.all(photos.map((p) => getImage({ src: p.image, width: 2000, format: 'webp' })));
const altText = `${d.title}, ${FORMAT_LABEL[d.format].toLowerCase()} by Java User Group Gujarat${d.venueName ? ` at ${d.venueName}` : ''}`;
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  description,
  url,
  image,
  startDate: iso(d.startTime),
  ...(d.endTime ? { endDate: iso(d.endTime) } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode:
    d.format === 'online' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  location:
    d.format === 'online'
      ? { '@type': 'VirtualLocation', url: d.lumaUrl ?? url }
      : {
          '@type': 'Place',
          name: d.venueName ?? d.city,
          address: { '@type': 'PostalAddress', streetAddress: d.address, addressLocality: d.city, addressRegion: 'Gujarat', addressCountry: 'IN' },
        },
  organizer: { '@id': `${SITE.url}/#organization` },
  performer: speakers.map((s) => ({ '@type': 'Person', name: s.data.name, url: new URL(`/people/${s.id}`, Astro.site).href })),
  sponsor: partners.filter((p) => p.role !== 'community').map((p) => ({ '@type': 'Organization', name: p.entry.data.name, url: p.entry.data.website })),
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: ctaUrl ?? url },
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description,
  image,
  datePublished: d.date.toISOString(),
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: url,
  about: { '@type': 'Event', name: d.title },
  keywords: ['Java', 'Java User Group', 'Gujarat JUG', d.city, ...d.tags].join(', '),
};
---
<Base
  title={d.title}
  description={description}
  image={ogImagePath}
  type="article"
  publishedTime={d.date}
  breadcrumbs={[{ name: 'Events', href: '/events' }, { name: d.title, href: `/events/${event.id}` }]}
  jsonLd={[eventLd, articleLd]}
  keywords={['Java meetup Ahmedabad', 'Java User Group Gujarat', ...d.tags, ...speakers.map((s) => s.data.name)]}
>
  <article class="pb-8" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- Article header -->
    <header class="container-x max-w-4xl pt-8 text-center">
      <div class="flex flex-wrap justify-center gap-2">
        {upcoming && <span class="chip border-duke bg-duke text-white">Upcoming</span>}
        {d.meetupNumber && <span class="chip text-duke">Meetup #{d.meetupNumber}</span>}
        <span class="chip text-duke">{FORMAT_LABEL[d.format]}</span>
        {d.tags.map((t) => <a href={`/events?tag=${t}`} class="chip hover:text-duke">#{t}</a>)}
      </div>
      <h1 class="h-display reveal mt-6 text-4xl sm:text-6xl" itemprop="headline">{d.title}</h1>
      {(d.summary || d.tagline) && <p class="reveal mx-auto mt-5 max-w-2xl text-xl text-muted" style="--d:80ms">{d.summary ?? d.tagline}</p>}
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-widest text-muted">
        <span>By the Gujarat JUG team</span><span aria-hidden="true">·</span>
        <time datetime={d.date.toISOString().slice(0, 10)} itemprop="datePublished">{dateText}</time><span aria-hidden="true">·</span>
        <span>{readMins} min read</span>
      </p>
    </header>

    {(banner || d.cover) && (
      <figure class="container-x reveal mt-10 max-w-5xl">
        {banner ? (
          <Image src={banner.image} alt={`Group photo: ${altText}`} widths={[640, 1024, 1600, 2000]} sizes="(min-width: 1024px) 1024px, 100vw"
            loading="eager" fetchpriority="high" itemprop="image"
            class="aspect-[16/9] w-full rounded-3xl border border-black/10 bg-mist object-cover shadow-xl" transition:name={`cover-${event.id}`} />
        ) : (
          <img src={d.cover} alt={altText} itemprop="image"
            class="aspect-[16/9] w-full rounded-3xl border border-black/10 bg-mist object-cover shadow-xl" transition:name={`cover-${event.id}`} />
        )}
        {banner && <figcaption class="mt-3 text-center text-sm text-muted">The Gujarat JUG community at {d.title}</figcaption>}
      </figure>
    )}

    <div class="container-x mt-14 grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0">
        <!-- Story (Markdown body) -->
        <div class="prose-jug" itemprop="articleBody"><Content /></div>

        {d.lumaUrl && (
          <p class="mt-8 border-t border-black/10 pt-6 text-sm text-muted">
            Source: this {d.format === 'meetup' ? 'meetup' : 'event'} was originally listed on Luma.{" "}
            <a href={d.lumaUrl} target="_blank" rel="noopener" class="font-semibold text-duke underline underline-offset-4">See the original event page on Luma ↗</a>
          </p>
        )}
        {!d.lumaUrl && (
          <p class="mt-8 border-t border-black/10 pt-6 text-sm text-muted">
            Source: this event is listed with all our meetups on Luma.{" "}
            <a href={SITE.links.luma} target="_blank" rel="noopener" class="font-semibold text-duke underline underline-offset-4">See Gujarat JUG on Luma ↗</a>
          </p>
        )}

        {!d.recapReady && !upcoming && photos.length === 0 && !banner && (
          <aside class="mt-8 flex items-center gap-5 rounded-3xl border border-dashed border-duke/40 bg-mist p-6">
            <Duke size={56} float={false} />
            <p class="text-muted">More photos and highlights from the day are on their way. Were you there? Share your photos and posts with us on <a class="text-duke underline" href={SITE.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> and we may feature them here.</p>
          </aside>
        )}

        <!-- Gallery -->
        {photos.length > 0 && (
          <section class="mt-16" aria-labelledby="gallery">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <h2 id="gallery" class="text-3xl font-bold">Photos from the event</h2>
              <a href={`/gallery?meetup=${d.meetupNumber}`} class="text-sm font-semibold text-duke hover:underline">Open in gallery →</a>
            </div>
            <div class="mt-8 columns-2 gap-3 sm:columns-3">
              {photos.map((p, i) => (
                <a href={fullSizes[i].src} data-lightbox data-caption={`${d.title} · photo ${i + 1} of ${photos.length}`}
                  class="reveal group mb-3 block break-inside-avoid overflow-hidden rounded-2xl bg-mist">
                  <Image src={p.image} alt={`${altText}, photo ${i + 1}`} widths={[400, 800]} sizes="(min-width: 640px) 33vw, 50vw"
                    class="w-full transition duration-500 group-hover:scale-105" />
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Videos -->
        {d.videos.length > 0 && (
          <section class="mt-16" aria-labelledby="videos">
            <h2 id="videos" class="text-3xl font-bold">Watch the sessions</h2>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {d.videos.map((v) => (
                <div class="card overflow-hidden"><iframe class="aspect-video w-full" src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`} title={v.title} loading="lazy" allowfullscreen></iframe></div>
              ))}
            </div>
          </section>
        )}

      </div>

      <!-- At a glance -->
      <aside class="lg:sticky lg:top-28 lg:self-start" aria-label="Event details">
        <div class="overflow-hidden rounded-3xl border border-black/10 bg-white shadow-lg">
          <div class="bg-duke px-6 py-4 text-white"><p class="font-mono text-xs uppercase tracking-[0.25em]">At a glance</p></div>
          <dl class="divide-y divide-black/5 px-6">
            <div class="py-4"><dt class="text-xs uppercase tracking-wider text-muted">Date</dt><dd class="mt-1 font-semibold">{dateText}{d.startTime && `, ${d.startTime}${d.endTime ? `–${d.endTime}` : ''} IST`}</dd></div>
            <div class="py-4"><dt class="text-xs uppercase tracking-wider text-muted">Venue</dt>
              <dd class="mt-1 font-semibold">{venuePartner ? <a href={`/partners/${venuePartner.id}`} class="hover:text-duke">{d.venueName ?? venuePartner.data.name}</a> : (d.venueName ?? d.city)}</dd>
              {d.address && <dd class="mt-1 text-sm text-muted">{d.address}</dd>}
            </div>
            <div class="py-4"><dt class="text-xs uppercase tracking-wider text-muted">Format</dt><dd class="mt-1 font-semibold">{FORMAT_LABEL[d.format]} · Free</dd></div>
            {(d.registered || d.attended) && (
              <div class="grid grid-cols-2 gap-4 py-4">
                {d.registered && <div><dt class="text-xs uppercase tracking-wider text-muted">Registered</dt><dd class="mt-1 text-3xl font-bold text-duke" data-count={d.registered}>{d.registered}</dd></div>}
                {d.attended && <div><dt class="text-xs uppercase tracking-wider text-muted">Attended</dt><dd class="mt-1 text-3xl font-bold text-duke" data-count={d.attended}>{d.attended}</dd></div>}
              </div>
            )}
          </dl>
          <div class="flex flex-col gap-2 p-6 pt-2">
            {ctaUrl && <a href={ctaUrl} target="_blank" rel="noopener" class="btn-primary justify-center">{upcoming ? 'Register now →' : 'View on Luma ↗'}</a>}
            {d.mapUrl && <a href={d.mapUrl} target="_blank" rel="noopener" class="btn-ghost justify-center">Directions ↗</a>}
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="container-x mt-20 max-w-6xl" aria-labelledby="more">
      <h2 id="more" class="text-3xl font-bold">More from Gujarat JUG</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">{related.map((e, i) => <EventCard event={e} delay={i * 60} />)}</div>
    </section>
  )}
  <Lightbox />
</Base>
