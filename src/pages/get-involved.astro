---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Duke from '../components/Duke.astro';
import { SITE } from '../lib/site';

const paths = [
  { id: 'attend', emoji: '🎟️', title: 'Attend', body: 'Follow us on Luma and join the WhatsApp group to hear about every meetup first.', cta: 'Follow on Luma', href: SITE.links.luma, alt: { label: 'Join WhatsApp', href: SITE.links.whatsapp } },
  { id: 'speak', emoji: '🎤', title: 'Give a talk', body: "Got something you learned the hard way? Share it. First-time speakers are welcome and we'll help you prepare.", cta: 'Message us on LinkedIn', href: SITE.links.linkedin },
  { id: 'volunteer', emoji: '🙌', title: 'Volunteer', body: 'Help with check-in, photos, social media, design or stage. It is the fastest way to meet everyone.', cta: 'Volunteer form', href: SITE.links.volunteerForm },
  { id: 'sponsor', emoji: '🏢', title: 'Host or sponsor', body: 'Open your office for a meetup, sponsor food or goodies, or back Community Day for Java.', cta: 'Get in touch', href: SITE.links.linkedin },
];
---
<Base title="Get involved" description="Attend, speak, volunteer or sponsor at Gujarat JUG." breadcrumbs={[{ name: "Get involved", href: "/get-involved" }]}>
  <PageHero eyebrow="// get involved" title="Pick your path" lead="There's no membership fee and no gatekeeping. Show up, and if you like it, help out." />
  <section class="container-x grid gap-6 md:grid-cols-2">
    {paths.map((p, i) => (
      <div id={p.id} class="card card-hover reveal scroll-mt-28 p-8 sm:p-10" style={`--d:${i * 80}ms`}>
        <p class="text-5xl">{p.emoji}</p>
        <h2 class="mt-5 text-3xl font-bold">{p.title}</h2>
        <p class="mt-3 text-lg text-muted">{p.body}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={p.href} target="_blank" rel="noopener" class="btn-primary">{p.cta} ↗</a>
          {p.alt && <a href={p.alt.href} target="_blank" rel="noopener" class="btn-ghost">{p.alt.label} ↗</a>}
        </div>
      </div>
    ))}
  </section>
  <section class="container-x mt-20 flex justify-center"><Duke size={180} steam /></section>
</Base>
