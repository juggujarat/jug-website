---
import Base from '../layouts/Base.astro';
import QrCard from '../components/QrCard.astro';
import { SITE } from '../lib/site';

const primary = [
  { icon: '💬', title: 'Join our WhatsApp community', sub: 'Meetup alerts, slides and conversations', href: SITE.links.whatsapp },
  { icon: '📅', title: 'Upcoming events', sub: 'RSVP on Luma', href: SITE.links.luma },
  { icon: '🙌', title: 'Join us as a volunteer', sub: 'Give back to the Java community', href: SITE.links.volunteerForm },
  { icon: '🎤', title: 'Speak at our upcoming meetup', sub: 'Submit your talk idea', href: SITE.links.speakerForm },
];
const more = [
  { icon: '🗓️', title: 'Past meetups & recaps', sub: 'Every event, with photos and talks', href: '/events' },
  { icon: '▶️', title: 'Watch talk recordings', sub: 'YouTube', href: SITE.links.youtube },
  { icon: '📸', title: 'Photo gallery', sub: 'Moments from our meetups', href: '/gallery' },
  { icon: '🤝', title: 'Host or sponsor a meetup', sub: 'Partner with Gujarat JUG', href: '/get-involved#sponsor' },
];
const socials = [
  { label: 'Website', href: '/' },
  { label: 'LinkedIn', href: SITE.links.linkedin },
  { label: 'X', href: SITE.links.x },
  { label: 'YouTube', href: SITE.links.youtube },
  { label: 'GitHub', href: SITE.links.github },
];
const ext = (h: string) => h.startsWith('http');
---
<Base title="Links" description="All Gujarat JUG links in one place: join the WhatsApp community, RSVP for upcoming Java meetups on Luma, volunteer, submit a talk and follow us." breadcrumbs={[{ name: 'Links', href: '/join' }]}>
  <section class="relative overflow-hidden pt-6 pb-10 grain">
    <div class="blob pointer-events-none absolute -top-32 left-1/2 size-[520px] -translate-x-1/2 rounded-full bg-duke/10 blur-[120px]"></div>
    <div class="relative mx-auto max-w-xl px-4 text-center">
      <img src="/Img/JugIcon.svg" alt="" width="96" height="96" class="reveal mx-auto size-24 rounded-full bg-white p-2 shadow-sm ring-1 ring-black/10" />
      <h1 class="reveal mt-5 text-3xl font-bold sm:text-4xl" style="--d:60ms">Java User Group, Gujarat</h1>
      <p class="reveal mt-2 text-lg text-muted" style="--d:120ms">Connecting Java enthusiasts in Gujarat!</p>
      <div class="reveal mt-5 flex flex-wrap justify-center gap-2" style="--d:180ms">
        {socials.map((s) => <a class="chip hover:border-duke hover:text-duke" href={s.href} {...(ext(s.href) ? { target: '_blank', rel: 'noopener' } : {})}>{s.label}</a>)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-xl px-4">
    <ul class="space-y-3">
      {primary.map((l, i) => (
        <li class="reveal" style={`--d:${i * 50}ms`}>
          <a href={l.href} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl bg-duke px-5 py-4 text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-duke-dark hover:shadow-lg">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/15 text-2xl" aria-hidden="true">{l.icon}</span>
            <span class="min-w-0 flex-1 text-left"><span class="block text-lg font-bold leading-tight">{l.title}</span><span class="block text-sm text-white/80">{l.sub}</span></span>
            <span class="text-xl transition group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="eyebrow mt-10 mb-3 text-center">// more from the community</p>
    <ul class="space-y-3">
      {more.map((l, i) => (
        <li class="reveal" style={`--d:${i * 50}ms`}>
          <a href={l.href} {...(ext(l.href) ? { target: '_blank', rel: 'noopener' } : {})} class="card group flex items-center gap-4 px-5 py-4 transition hover:-translate-y-0.5 hover:border-duke/40">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-duke/10 text-2xl" aria-hidden="true">{l.icon}</span>
            <span class="min-w-0 flex-1 text-left"><span class="block text-lg font-bold leading-tight group-hover:text-duke">{l.title}</span><span class="block text-sm text-muted">{l.sub}</span></span>
            <span class="text-xl text-muted transition group-hover:translate-x-0.5 group-hover:text-duke" aria-hidden="true">{ext(l.href) ? '↗' : '→'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-x mt-20">
    <div class="text-center">
      <p class="eyebrow">// at a meetup?</p>
      <h2 class="h-display mt-3 text-4xl sm:text-5xl">Scan and join</h2>
      <p class="mt-3 text-muted">Point your phone camera at a code. Each one opens the same link as the buttons above.</p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      <QrCard k="whatsapp" delay={0} />
      <QrCard k="luma" delay={60} />
      <QrCard k="speak" delay={120} />
      <QrCard k="volunteer" delay={180} />
    </div>
  </section>
</Base>
